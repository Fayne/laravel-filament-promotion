{
    "name": "fayne/laravel-filament-promotion",
    "description": "Promotion rules and discount calculation for Laravel and Filament.",
    "type": "library",
    "license": "proprietary",
    "require": {"php": "^8.4", "illuminate/support": "^13.0", "illuminate/database": "^13.0", "filament/filament": "^5.0"},
    "require-dev": {"orchestra/testbench": "^11.0", "pestphp/pest": "^4.0", "pestphp/pest-plugin-laravel": "^4.1", "laravel/pint": "^1.27"},
    "autoload": {"psr-4": {"Fayne\\Promotion\\": "src/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {"test": "pest", "format": "pint --test", "format:fix": "pint"},
    "extra": {"laravel": {"providers": ["Fayne\\Promotion\\PromotionServiceProvider"]}},
    "minimum-stability": "dev", "prefer-stable": true,
    "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
